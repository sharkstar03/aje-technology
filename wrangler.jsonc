{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aje-technology",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ajetechnologypa.com", "custom_domain": true },
    { "pattern": "www.ajetechnologypa.com", "custom_domain": true }
  ]
}
